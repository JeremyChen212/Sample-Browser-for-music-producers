# Dependencies (reinstalled via `npm install`; package-lock.json IS tracked)
node_modules

# Build output (regenerated by `npm run dev` / `npm run build`)
dist
dist-electron
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Environment variables / secrets — this project doesn't currently use any,
# ignored defensively so one never ends up committed by accident later.
.env
.env.*
!.env.example

# macOS Finder metadata
.DS_Store

# Editor/IDE settings
.vscode/
.idea/

# The app always reads samples from a folder you choose at runtime — never
# from inside the repo — so any audio files here would only be personal
# library files dropped in by accident, not project data.
*.wav
*.aif
*.aiff
*.mp3
*.flac
